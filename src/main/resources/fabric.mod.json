{
	"schemaVersion": 1,
	"id": "betterwithbags",
	"version": "${version}",
	"name": "Better With Bags",
	"description": "Craftable backpacks you can wear, place in the world, and upgrade through multiple tiers.",
	"authors": [
		"SajmonOriginal"
	],
	"contributors": [
		"badsbee",
		"Sour Zombo"
	],
	"contact": {
		"sources": "https://github.com/MinecraftLabs/better-with-bags"
	},
	"license": "See LICENSE",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.sajmonoriginal.betterwithbags.BetterWithBagsMod"
		],
		"beforeGameStart": [
			"com.sajmonoriginal.betterwithbags.BetterWithBagsMod"
		],
		"client": [
			"com.sajmonoriginal.betterwithbags.BetterWithBagsClientMod"
		],
		"afterClientStart": [
			"com.sajmonoriginal.betterwithbags.BetterWithBagsClientMod"
		],
		"initModels": [
			"com.sajmonoriginal.betterwithbags.BackpackModels"
		],
		"recipesReady": [
			"com.sajmonoriginal.betterwithbags.BackpackRecipes"
		]
	},
	"mixins": [
		"betterwithbags.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"halplibe": ">=${halplibe}",
		"minecraft": "*",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": ">=${modmenu}"
	}
}
